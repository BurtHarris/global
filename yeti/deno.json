{
  "name": "@global/yeti",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./converter": "./src/converter.ts",
    "./tui/font": "./src/tui/font.ts",
    "./tui/glyphs": "./src/tui/glyphs.ts"
  },
  "tasks": {
    "test": "deno test --allow-run=pandoc --allow-read --allow-write --allow-env test/",
    "test:conformance": "deno test --allow-run=pandoc --allow-read --allow-write --allow-env test/conformance/",
    "conformance": "deno run --allow-run=pandoc --allow-read --allow-write --allow-env test/conformance/cli.ts",
    "conformance:update": "deno run --allow-run=pandoc --allow-read --allow-write --allow-env test/conformance/cli.ts --update-goldens",
    "check": "deno check src/**/*.ts test/**/*.ts",
    "fmt": "deno fmt src/ test/",
    "lint": "deno lint src/ test/"
  },
  "imports": {
    "@david/dax": "jsr:@david/dax@^0.50.0",
    "@guild/pandoc": "../../guild/packages/pandoc/src/mod.ts",
    "@guild/pandoc/ast": "../../guild/packages/pandoc/src/ast/mod.ts",
    "@guild/pandoc/transformer": "../../guild/packages/pandoc/src/transformer/mod.ts",
    "@guild/pandoc/cli": "../../guild/packages/pandoc/src/cli.ts",
    "@std/assert": "jsr:@std/assert@^1.0.8",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.8",
    "mdast-util-from-markdown": "npm:mdast-util-from-markdown@^2.0.2",
    "micromark-extension-gfm": "npm:micromark-extension-gfm@^3.0.0",
    "mdast-util-gfm": "npm:mdast-util-gfm@^3.1.0",
    "micromark-extension-frontmatter": "npm:micromark-extension-frontmatter@^2.0.0",
    "mdast-util-frontmatter": "npm:mdast-util-frontmatter@^2.0.1"
  },
  "fmt": {
    "semiColons": true,
    "singleQuote": false,
    "indentWidth": 2
  }
}
